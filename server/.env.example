APP_PORT=3000
APP_HOST=127.0.0.1
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=30000
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=false
ENFORCE_HTTPS=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=erp_user
DB_PASSWORD=erp_password
DB_NAME=erp_dev
DB_QUERY_TIMEOUT_MS=10000
DB_TRANSACTION_TIMEOUT_MS=30000
# Optional for local MySQL installations that use a Unix socket.
DB_SOCKET_PATH=

# JWT settings. Use a random secret of at least 32 characters in every real environment.
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_ISSUER=erp-api
JWT_AUDIENCE=erp-web
JWT_EXPIRES_IN=2h
JWT_CLOCK_TOLERANCE_SECONDS=5
